# Node 24+。复制为 .env；不要将 token 写入 HTML 或提交到仓库。
HOST=127.0.0.1
PORT=8765
PUBLIC_ORIGIN=http://127.0.0.1:8765
DATA_DIR=./data
# demo: 明确标注的开发练习数据。tushare: 正式数据接口，不回退到模拟数据。
MARKET_PROVIDER=demo
TUSHARE_TOKEN=
# rt_k 需要独立的 A股日线RT 权限；daily 仅显示盘后数据，不能实时成交。
TUSHARE_QUOTES=rt_k
TUSHARE_MINUTES=false
TUSHARE_INDEX_RT=false
TUSHARE_FINANCIALS=false
# 按已购买权限调整；服务端全局限频、缓存和去重。
PROVIDER_REQUESTS_PER_MINUTE=30
QUOTE_POLL_SECONDS=60
QUOTE_MAX_AGE_SECONDS=120
# 数据商明确约定的延迟秒数。留空表示未知，真实撮合关闭。
QUOTE_DELAY_SECONDS=
# 确认数据使用范围后开启。个人 token 不等于公开再分发许可。
MARKET_DATA_LICENSED=false
# 本地部署使用 false；HTTPS 公网部署必须 true。
COOKIE_SECURE=false
COMMISSION_RATE=0.0003
MIN_COMMISSION_YUAN=5
STAMP_TAX_RATE=0.0005
TRANSFER_RATE=0.00001
